
<Window x:Class="Wpf_SimpleCalculator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Calculator" Height="450" Width="400" ResizeMode="NoResize" WindowStyle="ThreeDBorderWindow" Loaded="Window_Loaded" Closed="Window_Closed">
    <Window.Resources>
        <Style TargetType="Button" x:Key="RoundedButtonStyle">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Window.Background>
        <SolidColorBrush Color="{DynamicResource {x:Static SystemColors.ControlColorKey}}"/>
    </Window.Background>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="6*"/>
            <ColumnDefinition Width="19*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBox 
            x:Name="ExpressionTextBox" 
            Grid.Row="0"
            Height="30" 
            FontSize="14"
            TextAlignment="Right"            
            VerticalAlignment="Bottom"
            Margin="5 0"
            IsReadOnly="True"   
            Background="{x:Null}" BorderBrush="{x:Null}" Grid.ColumnSpan="2"/>

        <TextBox 
            x:Name="ResultTextBox" 
            Grid.Row="1"
            Height="45" 
            FontSize="34"
            FontWeight="Bold"
            TextAlignment="Right"
            VerticalAlignment="Bottom"
            Margin="5,0,5,5"
            IsReadOnly="True"
            Text="0"
            Background="{x:Null}" BorderBrush="{x:Null}" Grid.ColumnSpan="2"/>

        <Grid Grid.Row="2" Margin="10,10,10,10" Grid.ColumnSpan="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Buttons -->
            <Button Content="C" Grid.Row="0" Grid.Column="0" Click="Clear_Click" Margin="2" Style="{StaticResource RoundedButtonStyle}" ToolTip="Reset to zero"/>
            <Button Content="⌫" Grid.Row="0" Grid.Column="1" Click="Backspace_Click" Margin="2" Style="{StaticResource RoundedButtonStyle}" ToolTip="Backspace"/>
            <Button Content="%" Grid.Row="0" Grid.Column="2" Click="Operator_Click" Margin="2" Style="{StaticResource RoundedButtonStyle}" ToolTip="Remainder from division"/>
            <Button Content="÷" Grid.Row="0" Grid.Column="3" Click="Operator_Click" Margin="2" Style="{StaticResource RoundedButtonStyle}"/>

            <Button Content="7" Grid.Row="1" Grid.Column="0" Click="Number_Click" Margin="2" Background="White" Style="{StaticResource RoundedButtonStyle}"/>
            <Button Content="8" Grid.Row="1" Grid.Column="1" Click="Number_Click" Margin="2" Background="White" Style="{StaticResource RoundedButtonStyle}"/>
            <Button Content="9" Grid.Row="1" Grid.Column="2" Click="Number_Click" Margin="2" Background="White" Style="{StaticResource RoundedButtonStyle}"/>
            <Button Content="×" Grid.Row="1" Grid.Column="3" Click="Operator_Click" Margin="2" Style="{StaticResource RoundedButtonStyle}"/>

            <Button Content="4" Grid.Row="2" Grid.Column="0" Click="Number_Click" Margin="2" Background="White" Style="{StaticResource RoundedButtonStyle}"/>
            <Button Content="5" Grid.Row="2" Grid.Column="1" Click="Number_Click" Margin="2" Background="White" Style="{StaticResource RoundedButtonStyle}"/>
            <Button Content="6" Grid.Row="2" Grid.Column="2" Click="Number_Click" Margin="2" Background="White" Style="{StaticResource RoundedButtonStyle}"/>
            <Button Content="-" Grid.Row="2" Grid.Column="3" Click="Operator_Click" Margin="2" Style="{StaticResource RoundedButtonStyle}"/>

            <Button Content="1" Grid.Row="3" Grid.Column="0" Click="Number_Click" Margin="2" Background="White" Style="{StaticResource RoundedButtonStyle}"/>
            <Button Content="2" Grid.Row="3" Grid.Column="1" Click="Number_Click" Margin="2" Background="White" Style="{StaticResource RoundedButtonStyle}"/>
            <Button Content="3" Grid.Row="3" Grid.Column="2" Click="Number_Click" Margin="2" Background="White" Style="{StaticResource RoundedButtonStyle}"/>
            <Button Content="+" Grid.Row="3" Grid.Column="3" Click="Operator_Click" Margin="2" Style="{StaticResource RoundedButtonStyle}"/>

            <Button Content="±" Grid.Row="4" Grid.Column="0" Click="PlusMinus_Click" Margin="2" Background="White" Style="{StaticResource RoundedButtonStyle}" ToolTip="Inverts to negative or positive value"/>
            <Button Content="0" Grid.Row="4" Grid.Column="1" Click="Number_Click" Margin="2" Background="White" Style="{StaticResource RoundedButtonStyle}"/>
            <Button Content="." Grid.Row="4" Grid.Column="2" Click="Dot_Click" Margin="2" Background="White" Style="{StaticResource RoundedButtonStyle}"/>
            <Button Content="=" Grid.Row="4" Grid.Column="3" Click="Equal_Click" Background="#FF62C9EC" Margin="2" Style="{StaticResource RoundedButtonStyle}"/>
        </Grid>
    </Grid>
</Window>


    
    